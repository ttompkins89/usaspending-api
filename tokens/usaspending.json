      "$value": "'Source Sans 3', 'Source Sans Pro', 'Helvetica Neue', Arial, sans-serif",
      "$extensions": {
        "source": "$font-sans: \"Source Sans Pro\", $helvetica"
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "'Source Code Pro', ui-monospace, Menlo, monospace",
      "$extensions": {
        "note": "Monospace sibling of Source Sans; the site uses the browser default monospace."
      }
    }
  }
}