{
  "$description": "Tally design tokens. Primitives use USWDS values that usaspending.gov already uses; components read only the semantic layer. To change the identity, edit the semantic layer or swap primitives, then run `npm run tokens`.",
  "primitive": {
    "color": {
      "navy":        { "$type": "color", "$value": "#162E51", "$description": "USWDS primary-darkest" },
      "blue-70":     { "$type": "color", "$value": "#1A4480", "$description": "USWDS primary-dark" },
      "blue-60v":    { "$type": "color", "$value": "#005EA2", "$description": "USWDS primary, the site's button blue" },
      "blue-10":     { "$type": "color", "$value": "#D9E8F6", "$description": "USWDS primary-lighter" },
      "cyan-5":      { "$type": "color", "$value": "#E7F6F8", "$description": "USWDS cyan-5, the site's search-panel tint" },
      "gold-20v":    { "$type": "color", "$value": "#FFBE2E", "$description": "USWDS accent-warm gold" },
      "gold-5":      { "$type": "color", "$value": "#FAF3D1" },
      "red-60v":     { "$type": "color", "$value": "#B50909", "$description": "USWDS secondary-dark" },
      "green-60v":   { "$type": "color", "$value": "#00754A", "$description": "USWDS green-cool-60v" },
      "ink":         { "$type": "color", "$value": "#1B1B1B", "$description": "USWDS base-darkest" },
      "gray-80":     { "$type": "color", "$value": "#3D4551", "$description": "USWDS base-darker" },
      "gray-60":     { "$type": "color", "$value": "#565C65", "$description": "USWDS base-dark" },
      "gray-10":     { "$type": "color", "$value": "#DFE1E2", "$description": "USWDS base-lighter" },
      "gray-5":      { "$type": "color", "$value": "#F0F0F0", "$description": "USWDS base-lightest" },
      "white":       { "$type": "color", "$value": "#FFFFFF" },
      "code-bg":     { "$type": "color", "$value": "#1B2330" },
      "code-text":   { "$type": "color", "$value": "#E6EAF0" }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": "var(--ff-display), 'Arial Narrow', sans-serif", "$description": "Big Shoulders Display, Tally's own display face" },
      "body":    { "$type": "fontFamily", "$value": "var(--ff-body), 'Helvetica Neue', Arial, sans-serif", "$description": "Public Sans, the USWDS typeface" },
      "mono":    { "$type": "fontFamily", "$value": "var(--ff-mono), ui-monospace, Menlo, monospace", "$description": "Roboto Mono, the USWDS monospace" }
    }
  },
  "semantic": {
    "color": {
      "bg":            { "$value": "{primitive.color.white}" },
      "bg-subtle":     { "$value": "{primitive.color.gray-5}" },
      "panel":         { "$value": "{primitive.color.cyan-5}" },
      "band":          { "$value": "{primitive.color.navy}", "$description": "The header band, like the site's page-header band" },
      "on-band":       { "$value": "{primitive.color.white}" },
      "on-band-muted": { "$value": "{primitive.color.blue-10}" },
      "text":          { "$value": "{primitive.color.ink}" },
      "text-body":     { "$value": "{primitive.color.gray-80}" },
      "text-muted":    { "$value": "{primitive.color.gray-60}" },
      "rule":          { "$value": "{primitive.color.gray-10}" },
      "action":        { "$value": "{primitive.color.blue-60v}" },
      "action-hover":  { "$value": "{primitive.color.blue-70}" },
      "highlight":     { "$value": "{primitive.color.gold-20v}" },
      "highlight-bg":  { "$value": "{primitive.color.gold-5}" },
      "focus":         { "$value": "{primitive.color.gold-20v}" },
      "method-get":    { "$value": "{primitive.color.green-60v}" },
      "method-post":   { "$value": "{primitive.color.blue-70}" },
      "danger":        { "$value": "{primitive.color.red-60v}" },
      "code-bg":       { "$value": "{primitive.color.code-bg}" },
      "code-text":     { "$value": "{primitive.color.code-text}" }
    },
    "font": {
      "display": { "$value": "{primitive.font.display}" },
      "body":    { "$value": "{primitive.font.body}" },
      "mono":    { "$value": "{primitive.font.mono}" }
    },
    "radius": {
      "sm": { "$value": "4px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "12px" },
      "pill": { "$value": "999px" }
    },
    "space": {
      "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
      "5": { "$value": "24px" }, "6": { "$value": "32px" }, "7": { "$value": "48px" }, "8": { "$value": "64px" }
    },
    "size": {
      "content": { "$value": "760px" },
      "page": { "$value": "1280px" },
      "sidebar": { "$value": "272px" }
    }
  }
}
