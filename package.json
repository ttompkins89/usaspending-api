{
  "name": "usaspending-api-docs",
  "version": "0.2.0",
  "private": true,
  "description": "Independent developer docs for the USAspending API, organized around the usaspending.gov features each endpoint powers.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "docs": "node scripts/build-docs.mjs",
    "resources": "node scripts/build-resources.mjs",
    "prebuild": "node scripts/build-tokens.mjs && node scripts/build-docs.mjs && node scripts/build-resources.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drafter.js": "^3.2.0",
    "typescript": "5.9.3"
  }
}
